{
  "name": "pi-talk-webcam",
  "productName": "pi-talk-webcam",
  "version": "0.1.0",
  "private": true,
  "description": "Offscreen Three.js rendering prototype",
  "author": "pi-talk-webcam",
  "license": "MIT",
  "main": ".vite/build/index.cjs",
  "scripts": {
    "camera:autoprovision": "node native/macos/camera/auto-sign.mjs",
    "camera:build": "node native/macos/camera/build.mjs",
    "camera:test": "node native/macos/camera/test.mjs",
    "camera:sign": "node native/macos/camera/sign.mjs",
    "camera:sign:check": "node native/macos/camera/sign.mjs --check",
    "camera:notarize": "node native/macos/camera/notarize.mjs",
    "audio:build": "node native/macos/audio/build.mjs",
    "native:build": "node native/build.mjs",
    "native:test": "pnpm native:build && node-gyp rebuild --directory native/macos/test && UV_THREADPOOL_SIZE=1 node native/macos/test/smoke.cjs",
    "dev": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs native/macos/vc4m/*.test.cjs",
    "artifact:check": "node test/artifact-checks/run.mjs",
    "package": "electron-forge package",
    "verify": "electron-forge start -- --verify"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/osx-sign": "^2.7.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "electron": "44.9.0",
    "node-gyp": "^12.4.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
